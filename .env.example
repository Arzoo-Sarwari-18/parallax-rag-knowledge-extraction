# Copy this file to .env and fill in real values. .env is git-ignored.

# --- LLM generation (Week 2+, DeepSeek via OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat

# --- Reddit data source (only needed if --source reddit) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ParallaxLabsRAG/1.0
