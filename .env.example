# Copy this file to .env and fill in real values. .env is git-ignored.

# --- LLM generation (Week 3+, DeepSeek via OpenRouter) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# deepseek/deepseek-chat needs OpenRouter credit; for a fully free option
# use LLM_MODEL=meta-llama/llama-3-8b-instruct:free instead
LLM_MODEL=deepseek/deepseek-chat

# --- Reddit data source (only needed if --source reddit) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ParallaxLabsRAG/1.0
